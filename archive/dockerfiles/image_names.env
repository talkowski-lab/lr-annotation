# Canonical Artifact Registry image name for each dockerfiles/Dockerfile.<Suffix>,
# keyed as <Suffix>=<image-name>. Used by dockerfiles/build_push.sh callers and by
# the docker-build-push CI workflow to resolve which image a changed Dockerfile maps to.
#
# Several of these names were already in use in the registry before this file existed
# (some with drifted/duplicate variants, e.g. cpgtools vs cpg-tools) -- the values below
# are the canonical ones to keep pushing to; older duplicate variants are left alone.

AnnotatePALMER=annotate-palmer
CpgTools=cpg-tools
HiFiCNV=hificnv
IntactMEI=intact-mei
Kanpig=kanpig
L1MEAID=l1meaid
MosDepth=mosdepth
PALMER=palmer
PAV=pav
STRAnalysis=stranalysis
SVAN=svan
TRGT=trgt
TRGTLPS=trgt-lps
Utils=utils
VEPHail=vep-hail
VRS=vrs
Vamos=vamos
Whatshap=whatshap
